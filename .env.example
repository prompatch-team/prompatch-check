# 복사해서 .env로 쓰세요. .env는 저장소에 올라가지 않아요.
# 값은 각자 넣고, 팀 채팅이나 이슈에 붙이지 않아요.
ANTHROPIC_API_KEY=
# 내 컴퓨터에만 있는 실제 가이드·글(.txt) 폴더 경로. 커밋 전 대조(tools/leak_check.py)가 읽어요.
# 비워 두면 대조는 블로그 주소와 키 모양만 봐요.
PROMPATCH_PRIVATE_DATA=
# 서버를 API 키 없이 돌리기: recorded면 저장된 예시 응답(samples/의 지어낸 가이드)만 써요. ai/ 코드가 없으면 늘 이 모드예요.
PROMPATCH_AI_MODE=
# AI 호출(조건 뽑기) 횟수 한도. 비워 두면 IP 하나가 10분에 10번, 서버 전체가 하루 500번이에요.
PROMPATCH_EXTRACT_PER_IP=
PROMPATCH_EXTRACT_PER_DAY=
# 서버 앞에 있는, 믿을 수 있는 프록시의 수. 비워 두면 0 (X-Forwarded-For를 보지 않아요). 배포할 곳의 문서를 보고 정해요.
PROMPATCH_PROXY_HOPS=
# AI에 보내는 글자 수 한도. 비워 두면 가이드 20000자, 원고 20000자.
PROMPATCH_AI_MAX_GUIDE=
PROMPATCH_AI_MAX_DRAFT=
# 키워드 과다 반복 안내(p3): 가이드 요구 횟수의 몇 배를 넘으면 알릴지. 비워 두면 2 (우리 기준)
PROMPATCH_KEYWORD_REPEAT_FACTOR=
# 글자 수에 사진 설명(캡션)을 넣을지: 비워 두면 넣어요. 0이면 빼요
PROMPATCH_COUNT_CAPTIONS=
# 조건을 뽑을 때 쓰는 모델 이름. 비워 두면 claude-haiku-5-5를 써요.
PROMPATCH_MODEL=
# AI 호출 시간 제한(초). 비워 두면 60초. 실패하면 1번 더 불러요.
PROMPATCH_AI_TIMEOUT=
# 셀 수 없는 조건 판단 때 보내는 원고 범위: full(원고 전체, 기본) 또는 related(관련 문단만)
PROMPATCH_JUDGE_SCOPE=
# 서버 기록의 AI 비용을 원으로 적을 때의 환율(1달러당 원). 비워 두면 1400
PROMPATCH_KRW_PER_USD=
