{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "점검 요청 (연결 ②, owner 리릭)",
  "type": "object",
  "required": [
    "version",
    "guide_text",
    "draft_text"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "guide_text": {
      "type": "string",
      "minLength": 1
    },
    "draft_text": {
      "type": "string",
      "minLength": 1
    },
    "photo_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "has_map": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": false
}